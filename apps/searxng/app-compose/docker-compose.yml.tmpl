services:
  searxng:
    image: docker.io/searxng/searxng:latest
    container_name: "{{.instance_id}}-searxng"
    restart: unless-stopped
    ports:
      - "{{.http_port}}:8080"
    environment:
      - SEARXNG_BASE_URL={{ serverURL }}
      - SEARXNG_SECRET={{.secret_key}}
      - SEARXNG_PORT=8080
      - SEARXNG_LIMITER=true
    volumes:
      - "{{ configPath }}/searxng:/etc/searxng:z"
      - "{{ dataPath }}/searxng-cache:/var/cache/searxng:z"
    labels:
      - "libreserv.app={{.instance_id}}"
      - "libreserv.app.name={{.app_name}}"
    cap_drop:
      - ALL
    depends_on:
      - valkey
    networks:
      - searxng-net

  valkey:
    image: docker.io/valkey/valkey:8-alpine
    container_name: "{{.instance_id}}-valkey"
    restart: unless-stopped
    command: valkey-server --save 30 1 --loglevel warning
    volumes:
      - "{{ dataPath }}/valkey-data:/data:z"
    labels:
      - "libreserv.app={{.instance_id}}"
      - "libreserv.app.component=valkey"
    cap_drop:
      - ALL
    networks:
      - searxng-net

networks:
  searxng-net:
    driver: bridge
