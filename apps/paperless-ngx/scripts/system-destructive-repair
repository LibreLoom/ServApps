#!/bin/bash
set -euo pipefail

# Paperless-ngx system-destructive-repair
# Wipes all Paperless data — documents, database, search index, and
# message broker — then restarts everything from a clean state.
# This is like reinstalling the app from scratch.

CONFIG_FILE="${1:-}"
INSTANCE_ID="${INSTANCE_ID:-unknown}"
INSTALL_PATH="${INSTALL_PATH:-/tmp}"
APP_DATA_PATH="${APP_DATA_PATH:-${INSTALL_PATH}/data}"
COMPOSE_FILE="${COMPOSE_FILE:-${INSTALL_PATH}/docker-compose.yml}"

if [ -z "$CONFIG_FILE" ] || [ ! -f "$CONFIG_FILE" ]; then
    echo "No config file provided" >&2
    exit 1
fi

HTTP_PORT=$(jq -r '.http_port // 8000' "$CONFIG_FILE" 2>/dev/null || echo "8000")

echo ">> [paperless-ngx] Starting destructive repair for instance ${INSTANCE_ID}"
echo ">> [paperless-ngx] WARNING: All documents, tags, saved views, and the database will be deleted"

# 1. Stop all containers
if command -v podman >/dev/null 2>&1; then
    echo ">> [paperless-ngx] Stopping containers"
    podman compose -f "$COMPOSE_FILE" down 2>/dev/null || true
fi

# 2. Wipe all data volumes
echo ">> [paperless-ngx] Removing all data files"
for vol in paperless-data paperless-media paperless-consume paperless-export paperless-db paperless-broker; do
    if [ -d "${APP_DATA_PATH}/${vol}" ]; then
        rm -rf "${APP_DATA_PATH:?}/${vol:?}"/* 2>/dev/null || true
    fi
done

# 3. Start containers
if command -v podman >/dev/null 2>&1; then
    echo ">> [paperless-ngx] Starting containers"
    podman compose -f "$COMPOSE_FILE" up -d 2>/dev/null || true
fi

# 4. Wait for health — Paperless needs time to initialize the database
# and run migrations on a fresh install.
echo ">> [paperless-ngx] Waiting for Paperless to initialize..."
for i in $(seq 1 90); do
    if curl -sf -L --max-time 2 "http://localhost:${HTTP_PORT}/" >/dev/null 2>&1; then
        echo ">> [paperless-ngx] Paperless is healthy with a fresh database"
        exit 0
    fi
    sleep 3
done

echo ">> [paperless-ngx] Paperless did not become healthy after destructive repair" >&2
exit 1
