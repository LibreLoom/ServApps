#!/bin/bash
set -euo pipefail

# Paperless-ngx system-repair
# Non-destructive: restarts the webserver and its dependencies, then
# verifies health. Paperless data (documents, database) is preserved.

CONFIG_FILE="${1:-}"
INSTANCE_ID="${INSTANCE_ID:-unknown}"
INSTALL_PATH="${INSTALL_PATH:-/tmp}"
COMPOSE_FILE="${COMPOSE_FILE:-${INSTALL_PATH}/docker-compose.yml}"

if [ -z "$CONFIG_FILE" ] || [ ! -f "$CONFIG_FILE" ]; then
    echo "No config file provided" >&2
    exit 1
fi

HTTP_PORT=$(jq -r '.http_port // 8000' "$CONFIG_FILE" 2>/dev/null || echo "8000")

echo ">> [paperless-ngx] Starting repair for instance ${INSTANCE_ID}"

# 1. Check if the webserver is responding
if ! curl -sf -L --max-time 2 "http://localhost:${HTTP_PORT}/" >/dev/null 2>&1; then
    echo ">> [paperless-ngx] Web server not responding — restarting containers"
    if command -v podman >/dev/null 2>&1; then
        podman compose -f "$COMPOSE_FILE" restart webserver 2>/dev/null || true
        sleep 10
    fi
fi

# 2. Restart dependencies that commonly cause issues
if command -v podman >/dev/null 2>&1; then
    echo ">> [paperless-ngx] Restarting database and message broker"
    podman compose -f "$COMPOSE_FILE" restart db broker 2>/dev/null || true
    sleep 5

    echo ">> [paperless-ngx] Restarting document converters"
    podman compose -f "$COMPOSE_FILE" restart gotenberg tika 2>/dev/null || true
    sleep 5

    # Give the webserver a moment to reconnect to its dependencies
    echo ">> [paperless-ngx] Restarting web server"
    podman compose -f "$COMPOSE_FILE" restart webserver 2>/dev/null || true
fi

# 3. Wait for health
echo ">> [paperless-ngx] Waiting for Paperless to become healthy..."
for i in $(seq 1 60); do
    if curl -sf -L --max-time 2 "http://localhost:${HTTP_PORT}/" >/dev/null 2>&1; then
        echo ">> [paperless-ngx] Repair completed — app is healthy"
        exit 0
    fi
    sleep 3
done

echo ">> [paperless-ngx] Paperless is still not responding after repair" >&2
exit 1
