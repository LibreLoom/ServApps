services:
  webserver:
    image: ghcr.io/paperless-ngx/paperless-ngx:latest
    container_name: "{{.instance_id}}-paperless"
    restart: unless-stopped
    depends_on:
      - db
      - broker
      - gotenberg
      - tika
    ports:
      - "{{.http_port}}:8000"
    environment:
      - PAPERLESS_URL={{ serverURL }}
      - PAPERLESS_SECRET_KEY={{.secret_key}}
      - PAPERLESS_REDIS=redis://broker:6379
      - PAPERLESS_DBHOST=db
      - PAPERLESS_DBENGINE=postgresql
      - PAPERLESS_DBNAME=paperless
      - PAPERLESS_DBUSER=paperless
      - PAPERLESS_DBPASS=paperless
      - PAPERLESS_TIKA_ENABLED=1
      - PAPERLESS_TIKA_ENDPOINT=http://tika:9998
      - PAPERLESS_TIKA_GOTENBERG_ENDPOINT=http://gotenberg:3000
      - PAPERLESS_OCR_LANGUAGE={{.ocr_language}}
      - PAPERLESS_APPS=allauth.socialaccount.providers.openid_connect
      - PAPERLESS_SOCIALACCOUNT_PROVIDERS={"openid_connect":{"SERVERS":[{"id":"libreserv","name":"LibreServ","server_url":"{{.oidc_issuer}}","client_id":"{{.oidc_client_id}}","client_secret":"{{.oidc_client_secret}}","scopes":["openid","profile","email"]}]}}
      - PAPERLESS_SOCIAL_AUTO_SIGNUP=true
      - PAPERLESS_SOCIALACCOUNT_ALLOW_SIGNUPS=false
      - PAPERLESS_DISABLE_REGULAR_LOGIN=true
      - PAPERLESS_REDIRECT_LOGIN_TO_SSO=true
      - PAPERLESS_LOGOUT_REDIRECT_URL={{ logoutURL }}
    volumes:
      - "{{ dataPath }}/paperless-data:/usr/src/paperless/data:z"
      - "{{ dataPath }}/paperless-media:/usr/src/paperless/media:z"
      - "{{ dataPath }}/paperless-consume:/usr/src/paperless/consume:z"
      - "{{ dataPath }}/paperless-export:/usr/src/paperless/export:z"
    labels:
      - "libreserv.app={{.instance_id}}"
      - "libreserv.app.name={{.app_name}}"
    cap_drop:
      - ALL
    networks:
      - paperless-net

  db:
    image: docker.io/library/postgres:18
    container_name: "{{.instance_id}}-paperless-db"
    restart: unless-stopped
    environment:
      - POSTGRES_DB=paperless
      - POSTGRES_USER=paperless
      - POSTGRES_PASSWORD=paperless
    volumes:
      - "{{ dataPath }}/paperless-db:/var/lib/postgresql/data:z"
    labels:
      - "libreserv.app={{.instance_id}}"
      - "libreserv.app.component=database"
    cap_drop:
      - ALL
    networks:
      - paperless-net

  broker:
    image: docker.io/valkey/valkey:9-alpine
    container_name: "{{.instance_id}}-paperless-broker"
    restart: unless-stopped
    command: valkey-server --save 30 1 --loglevel warning
    volumes:
      - "{{ dataPath }}/paperless-broker:/data:z"
    labels:
      - "libreserv.app={{.instance_id}}"
      - "libreserv.app.component=broker"
    cap_drop:
      - ALL
    networks:
      - paperless-net

  gotenberg:
    image: docker.io/gotenberg/gotenberg:8
    container_name: "{{.instance_id}}-paperless-gotenberg"
    restart: unless-stopped
    command:
      - "gotenberg"
      - "--chromium-disable-javascript=true"
      - "--chromium-allow-list=file:///tmp/.*"
    labels:
      - "libreserv.app={{.instance_id}}"
      - "libreserv.app.component=gotenberg"
    cap_drop:
      - ALL
    networks:
      - paperless-net

  tika:
    image: docker.io/apache/tika:latest
    container_name: "{{.instance_id}}-paperless-tika"
    restart: unless-stopped
    labels:
      - "libreserv.app={{.instance_id}}"
      - "libreserv.app.component=tika"
    cap_drop:
      - ALL
    networks:
      - paperless-net

networks:
  paperless-net:
    driver: bridge
